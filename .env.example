# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real secrets or passwords.

# ---------------------------------------------------------------- core
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-generated-key
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

TIME_ZONE=Asia/Kolkata

# ------------------------------------------------------------ database
# SQLite for the demo sprint. Switch to PostgreSQL 18 after the demo by
# replacing this one line and running migrate on a fresh database.
# See docs/09_LOCAL_POSTGRES.md. Tracked as debt item 1.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://cams_user:ChangeMe_Local_2026@localhost:5432/cams

# ----------------------------------------------------------- demo mode
# True  -> specimen line on every generated order, banner in the UI,
#          real email sending disabled, seed_demo permitted.
# False -> production behaviour. seed_demo refuses to run.
# See docs/08_DEMO_DATA.md.
DEMO_MODE=True

# --------------------------------------------------------------- auth
# Sprint uses plain Django username/password login; password for every
# seeded user is demo1234. The settings below apply once magic-link
# auth is built (debt item 3).
ALLOWED_EMAIL_DOMAINS=gpbhuj-demo.local
MAGIC_LINK_TIMEOUT_MINUTES=15
MAGIC_LINK_RATELIMIT_PER_EMAIL=5/h
MAGIC_LINK_RATELIMIT_PER_IP=20/h

# -------------------------------------------------------------- email
# Console backend in development; nothing leaves your machine.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@gpbhuj-demo.local
SERVER_EMAIL=no-reply@gpbhuj-demo.local

# ------------------------------------------------------- institution
# Used in order numbers, letterheads and page titles.
INSTITUTION_NAME=Government Polytechnic, Bhuj
INSTITUTION_CODE=GPB

# -------------------------------------------------------------- admin
# Non-default admin path. Reduces automated scanning noise.
ADMIN_URL=manage-a7f3/

# ------------------------------------------------------------ storage
# Order documents live outside the web root and are served only through
# a permission-checked view. See docs/03_SECURITY.md section 3.
MEDIA_ROOT=media/
